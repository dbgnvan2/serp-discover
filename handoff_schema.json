{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompetitorHandoff",
  "description": "Validated handoff from serp-discover (Tool 1) to serp-compete (Tool 2). v1.1 adds the optional top-level `moz` block (moz_api_upgrade_spec_v1.md T.4); it is NOT in `required`, so a v1.0 producer still validates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_run_id",
    "source_run_timestamp",
    "client_domain",
    "client_brand_names",
    "targets",
    "exclusions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "1.0 = original contract; 1.1 adds the optional `moz` block; 2.0/2.1 are the same shape but `targets[].rank` is the absolute SERP position rather than SerpAPI's per-page `position` (review chunk D1 / D-C-01)."
    },
    "source_run_id": {
      "type": "string"
    },
    "source_run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "client_domain": {
      "type": "string"
    },
    "client_brand_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "domain",
          "rank",
          "entity_type",
          "content_type",
          "title",
          "source_keyword",
          "primary_keyword_for_url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "rank": {
            "type": "integer"
          },
          "entity_type": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source_keyword": {
            "type": "string"
          },
          "primary_keyword_for_url": {
            "type": "string"
          }
        }
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_urls_excluded",
        "omit_list_excluded",
        "omit_list_used"
      ],
      "properties": {
        "client_urls_excluded": {
          "type": "integer"
        },
        "omit_list_excluded": {
          "type": "integer"
        },
        "omit_list_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "moz": {
      "type": "object",
      "description": "Optional Moz competitor signals, keyed by competitor domain. Additive and absent-safe: a consumer that ignores it behaves exactly as it did on v1.0. Present only when moz.competitor.enabled is true.",
      "additionalProperties": false,
      "required": [
        "domains"
      ],
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "domains": {
          "type": "object",
          "description": "domain -> signal block",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "data_available",
              "status"
            ],
            "properties": {
              "data_available": {
                "type": "boolean"
              },
              "status": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "ranking_keywords": {
                "type": "object",
                "required": [
                  "status",
                  "data_available"
                ],
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "data_available": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "anchor_texts": {
                "type": "object",
                "required": [
                  "status",
                  "data_available"
                ],
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "data_available": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "brand_authority": {
                "type": "object",
                "required": [
                  "status",
                  "data_available"
                ],
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "data_available": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "link_momentum": {
                "type": "object",
                "required": [
                  "status",
                  "data_available"
                ],
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "data_available": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "fetched_at": {
                "type": "string",
                "description": "When this block was collected (ISO 8601 UTC) \u2014 the OLDEST of its signals, since the block is only as current as its stalest part. Absent when nothing was collected."
              },
              "signals_fetched_at": {
                "type": "object",
                "description": "Per-signal collection time. Each signal is fetched and cached independently, so they can differ by up to the cache TTL (review chunk D2b)."
              },
              "complete": {
                "type": "boolean",
                "description": "False when an enabled signal was not obtained on this block. A block can carry real data for one signal and a gap in another (review chunk D2b)."
              },
              "signals_missing": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Enabled signals not obtained \u2014 failed, skipped by the cap or quota, or not yet fetched. Empty when the block is complete."
              }
            }
          }
        },
        "client": {
          "type": "object",
          "description": "The client's own Moz signals, for reference against the competitor scores. Optional; present only when moz.brand_authority is enabled.",
          "additionalProperties": false,
          "required": [
            "domain"
          ],
          "properties": {
            "domain": {
              "type": "string"
            },
            "brand_authority": {
              "type": "object"
            },
            "anchor_texts": {
              "type": "object",
              "description": "The client's own inbound anchor-text distribution. Present only when moz.competitor.client_anchor_texts is enabled. Carried here rather than in `domains` because the handoff excludes the client by design."
            },
            "fetched_at": {
              "type": "string",
              "description": "When the client's anchor text was collected (ISO 8601 UTC). Present with anchor_texts."
            }
          }
        }
      }
    }
  }
}
